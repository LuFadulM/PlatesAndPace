# Supabase — from the project's API settings, or from `supabase start` locally.
# Both are safe to expose to the browser: the anon key grants nothing on its own,
# because Row Level Security decides what every request may read and write.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in. Leave unset to run on magic links alone — auth.external.google
# in supabase/config.toml stays disabled until these exist.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
